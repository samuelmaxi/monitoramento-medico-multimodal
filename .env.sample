GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/
ROBOFLOW_API_KEY=

# Azure Speech Service (transcription)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Opcional: endpoint do recurso (padrão: https://<região>.api.cognitive.microsoft.com)
AZURE_SPEECH_ENDPOINT=
# Saída das transcrições (JSON e cópia do áudio de origem)
TRANSCRIPTION_OUTPUT_DIR=saida/transcricao

# Azure AI Language: sentimento (POST /sentiment) e US13 (Text Analytics for health + sentimento)
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Azure Storage (blob container for audio files)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=audio-transcripts


# Motor de alertas (US19). Sem SMTP nem webhook, os alertas ficam só no painel (saida/alertas.jsonl).
# Armazenamento: jsonl (padrão, saida/alertas.jsonl) ou memoria (testes)
ALERTA_STORE=jsonl
ALERTA_SAIDA_DIR=saida
# Lista separada por vírgula. Alertas de simulação vão para ALERTA_DESTINATARIOS_SIMULADO, se definida
ALERTA_DESTINATARIOS=
ALERTA_DESTINATARIOS_SIMULADO=
# E-mail por SMTP (ex.: Gmail com senha de app: smtp.gmail.com, porta 587, STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_STARTTLS=true
# Webhook de Teams ou Slack (formato {"text": ...})
ALERTA_WEBHOOK_URL=
# Base dos links de reconhecimento no e-mail (use túnel para acesso externo)
ALERTA_PUBLIC_BASE_URL=http://localhost:8000
# Segredo do token de reconhecimento. Se vazio, é gerado a cada execução
ALERTA_ACK_SECRET=
# Intervalo do timer de escalonamento e retentativas (segundos) e tentativas por canal
ALERTA_TIMER_S=30
ALERTA_TENTATIVAS_MAX=3
