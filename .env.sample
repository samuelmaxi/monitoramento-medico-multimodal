GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/

# Azure Speech Service (transcription)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure AI Language: sentimento (POST /sentiment) e US13 (Text Analytics for health + sentimento)
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Azure Storage (blob container for audio files)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=audio-transcripts

# Pipeline de vídeo (US05): fps de amostragem e pasta de saída
VIDEO_TARGET_FPS=5
VIDEO_OUTPUT_DIR=saida/video
VIDEO_ANONYMIZE_METHOD=fill

# API de pose em vídeo (POST /video/pose)
# Chave HMAC para pseudonimizar patient_id/encounter_id (>= 32 bytes):
#   python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_KEY=
POSE_CONFIG_PATH=video/pose/config.yaml
# Config da US13 usado por POST /text/analysis
TEXT_CONFIG_PATH=audio/text/config.yaml
VIDEO_MAX_UPLOAD_MB=500

# Barramento local de eventos (contrato US04); a US13 publica aqui
EVENTOS_JSONL=saida/eventos.jsonl
