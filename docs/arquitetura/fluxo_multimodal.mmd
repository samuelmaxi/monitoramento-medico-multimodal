%% Fluxo multimodal — Tech Challenge Fase 4 (US04), versão enxuta
%% Pipeline em Python na máquina do grupo; Azure (brazilsouth) só para os serviços de IA gerenciados e o envio do alerta.
%% Fonte do diagrama. Regenerar imagens: bash scripts/renderizar_diagrama.sh
flowchart LR
    subgraph F["Fontes (US03)"]
        direction TB
        FV["Vídeos clínicos<br/>fisioterapia · cirurgia"]
        FA["Áudios de consulta<br/>AudioSet · gravações simuladas"]
        FS["Sinais vitais<br/>MIMIC-IV Demo"]
        FP["Prescrições<br/>MIMIC-IV Demo"]
    end

    subgraph I["1 · Ingestão — local"]
        direction TB
        DIR[("Pasta dados/<br/>fora do Git")]
        REP["Replay dos sinais vitais<br/>simula o stream em tempo real"]
    end

    subgraph P["2 · Processamento — Azure: AI Speech · AI Language"]
        direction TB
        PV["Vídeo · Google Colab GPU<br/>OpenCV · OpenPose · YOLOv8"]
        PA["Áudio · local<br/>ffmpeg 16 kHz · openSMILE · YAMNet"]
        TRN["Azure AI Speech<br/>transcrição rápida · pt-BR<br/>diarização · phrase list"]
        CMD["Azure AI Language<br/>Text Analytics for health · pt<br/>entidades + negação"]
        CMP["Azure AI Language<br/>sentimento em pt"]
        PS["Sinais vitais · local<br/>limpeza + janela deslizante"]
        PP["Prescrições · local<br/>normalização de unidades"]
    end

    subgraph D["3 · Detecção de anomalias — local, Python"]
        direction TB
        DV["video/<br/>postura · assimetria · queda · área crítica"]
        DA["audio/<br/>fadiga · respiração · disartria"]
        DT["audio/text<br/>termos críticos · sentimento"]
        DS["sinais/<br/>NEWS2 + z-score robusto · tendência"]
        DP["prescricoes/<br/>dose · duplicidade · suspensão · ISMP"]
        DM["movimentacao/<br/>imobilidade · saída do leito · queda"]
    end

    BUS{{"Barramento local<br/>EventoAchado v1<br/>→ saida/eventos.jsonl"}}

    subgraph U["4 · Fusão multimodal (US18) — local"]
        direction TB
        LAL["fusao/alinhamento<br/>por patient_id · janela 60 min<br/>assina: modality ≠ fusao"]
        LFU["fusao/score · late fusion<br/>força = peso × severidade<br/>noisy-OR + concordância clínica"]
        LEX["risco 0–1 · baixo/médio/alto<br/>contribuição por modalidade<br/>modalidade ausente = 0"]
        API["API /fusao<br/>GET /pacientes · POST /risco"]
    end

    subgraph A["5 · Alerta à equipe médica — Azure: Cosmos DB"]
        direction TB
        MAL["alertas/ (US19)<br/>assina: severity ≥ baixa<br/>prioridade · dedup · escalonamento"]
        ACS["E-mail SMTP · webhook Teams/Slack<br/>link de reconhecimento"]
        COS[("Azure Cosmos DB<br/>alerts · alert_events")]
        LOG[("saida/alertas.jsonl<br/>alternativa local")]
    end

    FV --> DIR
    FA --> DIR
    FS --> DIR
    FP --> DIR

    DIR --> PV
    DIR --> PA
    DIR --> REP --> PS
    DIR --> PP
    PA -->|"WAV 16 kHz mono"| TRN
    TRN -->|"falas do paciente"| CMD
    TRN --> CMP

    PV -->|"keypoints + detecções"| DV
    PV --> DM
    PA -->|"biomarcadores"| DA
    CMD --> DT
    CMP --> DT
    PS --> DS
    PP --> DP

    DV --> BUS
    DA --> BUS
    DT --> BUS
    DS --> BUS
    DP --> BUS
    DM --> BUS

    BUS --> LAL --> LFU --> LEX
    LEX --> API
    LEX -->|"risco_multimodal"| BUS
    BUS --> MAL
    MAL --> ACS
    MAL --> COS
    MAL --> LOG

    classDef fonte fill:#f4f4f5,stroke:#71717a,color:#18181b
    classDef local fill:#ffffff,stroke:#52525b,color:#18181b
    classDef azure fill:#eff6ff,stroke:#0078d4,color:#0c2d57,stroke-width:2px
    classDef bus fill:#ede9fe,stroke:#7c3aed,color:#3b0764,stroke-width:2px
    class FV,FA,FS,FP fonte
    class DIR,REP,PV,PA,PS,PP,DV,DA,DT,DS,DP,DM,LAL,LFU,LEX,API,MAL,ACS,LOG local
    class TRN,CMD,CMP,COS azure
    class BUS bus
    style F fill:#fafafa,stroke:#d4d4d8
    style I fill:#f8fafc,stroke:#cbd5e1
    style P fill:#f8fafc,stroke:#cbd5e1
    style D fill:#f8fafc,stroke:#cbd5e1
    style U fill:#f8fafc,stroke:#cbd5e1
    style A fill:#f8fafc,stroke:#cbd5e1
