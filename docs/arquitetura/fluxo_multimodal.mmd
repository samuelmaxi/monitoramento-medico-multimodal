%% Fluxo multimodal — Tech Challenge Fase 4 (US04), versão enxuta
%% Pipeline em Python na máquina do grupo; Azure (brazilsouth) só para os serviços de IA gerenciados e o envio do alerta.
%% Fonte do diagrama. Regenerar imagens: bash scripts/renderizar_diagrama.sh
flowchart LR
    subgraph F["Fontes (US03)"]
        direction TB
        FV["Vídeos clínicos<br/>fisioterapia · cirurgia"]
        FA["Áudios de consulta<br/>AudioSet · gravações simuladas"]
        FS["Sinais vitais<br/>MIMIC-IV Demo"]
        FP["Prescrições<br/>MIMIC-IV Demo"]
    end

    subgraph I["1 · Ingestão — local"]
        direction TB
        DIR[("Pasta dados/<br/>fora do Git")]
        REP["Replay dos sinais vitais<br/>simula o stream em tempo real"]
    end

    subgraph P["2 · Processamento — Azure: AI Speech · AI Language"]
        direction TB
        PV["Vídeo · Google Colab GPU<br/>OpenCV · OpenPose · YOLOv8"]
        PA["Áudio · local<br/>ffmpeg 16 kHz · openSMILE · YAMNet"]
        TRN["Azure AI Speech<br/>transcrição rápida · pt-BR<br/>diarização · phrase list"]
        CMD["Azure AI Language<br/>Text Analytics for health · pt<br/>entidades + negação"]
        CMP["Azure AI Language<br/>sentimento em pt"]
        PS["Sinais vitais · local<br/>limpeza + janela deslizante"]
        PP["Prescrições · local<br/>normalização de unidades"]
    end

    subgraph D["3 · Detecção de anomalias — local, Python"]
        direction TB
        DV["video/<br/>postura · assimetria · área crítica"]
        DA["audio/<br/>fadiga · respiração · disartria"]
        DT["audio/ (texto)<br/>termos críticos · sentimento"]
        DS["anomalias/sinais<br/>NEWS2 + Isolation Forest"]
        DP["anomalias/prescricoes<br/>dose · duplicidade · ISMP"]
        DM["anomalias/movimentacao<br/>imobilidade · saída do leito"]
    end

    BUS{{"Barramento local<br/>EventoAchado v1<br/>→ saida/eventos.jsonl"}}

    subgraph U["4 · Fusão — local"]
        LFU["fusao_alertas/fusao<br/>assina: modality ≠ fusao<br/>late fusion ponderada por paciente"]
    end

    subgraph A["5 · Alerta à equipe médica — Azure: Communication Services"]
        direction TB
        MAL["fusao_alertas/alertas<br/>assina: severity ≥ media<br/>prioridade · dedup · escalonamento"]
        ACS["Azure Communication Services<br/>e-mail da equipe"]
        LOG[("saida/alertas.jsonl<br/>log auditável")]
    end

    FV --> DIR
    FA --> DIR
    FS --> DIR
    FP --> DIR

    DIR --> PV
    DIR --> PA
    DIR --> REP --> PS
    DIR --> PP
    PA -->|"WAV 16 kHz mono"| TRN
