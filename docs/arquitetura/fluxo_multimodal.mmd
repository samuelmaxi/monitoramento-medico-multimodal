    PV -->|"keypoints + detecções"| DV
    PV --> DM
    PA -->|"biomarcadores"| DA
    CMD --> DT
    CMP --> DT
    PS --> DS
    PP --> DP

    DV --> BUS
    DA --> BUS
    DT --> BUS
    DS --> BUS
    DP --> BUS
    DM --> BUS

    BUS --> LFU
    LFU -->|"risco_multimodal"| BUS
    BUS --> MAL
    MAL --> ACS
    MAL --> LOG

    classDef fonte fill:#f4f4f5,stroke:#71717a,color:#18181b
