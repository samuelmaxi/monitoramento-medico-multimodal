    {
      "name": "Consulta com médico e paciente (transcrição Azure Speech)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "audio_file",
              "type": "file",
              "src": [],
              "description": "Selecione um áudio (wav, ogg/opus, flac, mp3, m4a...)"
            },
            {
              "key": "patient_id",
              "value": "10000032",
              "type": "text",
              "description": "ID de origem ou pseudônimo pt_…; pseudonimizado antes de sair"
            },
            {
              "key": "recorded_at",
              "value": "2026-10-01T13:00:00Z",
              "type": "text",
              "description": "Início da gravação, ISO-8601 em UTC"
            },
            {
              "key": "transcrever",
              "value": "true",
              "type": "text",
              "description": "Usa o Azure Speech"
            },
            {
              "key": "medico_falante",
              "value": "1",
              "type": "text",
              "description": "Número do falante que é o médico (ouça o áudio)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/audio/vocal",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "audio",
            "vocal"
          ]
        },
        "description": "Transcreve com o Azure Speech (US11, diarização): separa o paciente do médico e dá a taxa de fala. Sem credencial do Azure responde 503 e não grava nada."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 ou 503 (sem Azure configurado)\", () => pm.expect([200, 503]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "    const d = pm.response.json();",
              "    pm.test(\"taxa de fala medida\", () => pm.expect(d.biomarcadores.taxa_fala_pps).to.be.a(\"number\"));",
              "}"
            ]
          }
        }
      ]
    },
