    {
      "name": "US16 - Analisar prescrições",
      "description": "POST /prescricoes/analise recebe as ordens de uma internação (medicamento, dose, unidade, via, frequência, início, fim) e devolve os eventos EventoAchado (modality=prescricoes) com a justificativa em evidence.summary e os valores antes × depois em evidence.features. Horários em UTC. Sem `alta`, a suspensão abrupta não é avaliada.",
      "item": [
        {
          "id": "6f30a6e7-6388-5695-a546-595f891ed5eb",
          "name": "Mudança abrupta de dose (enoxaparina)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/prescricoes/analise?publicar={{publicar}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "prescricoes",
                "analise"
              ],
              "query": [
                {
                  "key": "publicar",
                  "value": "{{publicar}}"
                }
              ]
            },
            "description": "Enoxaparina 40 mg/dia (profilaxia) trocada por 100 mg a cada 12 h: +400% em 1 h. Esperado: mudanca_abrupta_dose media com antes_dose_diaria=40 e depois_dose_diaria=200. Mesmo caso real documentado no MIMIC-IV Demo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"sim-paciente-16a\",\n  \"encounter_id\": \"sim-paciente-16a-int1\",\n  \"admissao\": \"2026-10-01T10:00:00Z\",\n  \"alta\": \"2026-10-12T14:00:00Z\",\n  \"is_synthetic\": true,\n  \"prescricoes\": [\n    {\n      \"medicamento\": \"Enoxaparin Sodium\",\n      \"dose\": \"40\",\n      \"unidade\": \"mg\",\n      \"via\": \"SC\",\n      \"frequencia\": \"QPM\",\n      \"inicio\": \"2026-10-01T22:00:00Z\",\n      \"fim\": \"2026-10-03T11:00:00Z\",\n      \"doses_24h\": 1,\n      \"ordem_id\": \"enox-1\",\n      \"status\": \"Inactive (Due to a change order)\"\n    },\n    {\n      \"medicamento\": \"Enoxaparin Sodium\",\n      \"dose\": \"100\",\n      \"unidade\": \"mg\",\n      \"via\": \"SC\",\n      \"frequencia\": \"Q12H\",\n      \"inicio\": \"2026-10-03T12:00:00Z\",\n      \"fim\": \"2026-10-07T20:00:00Z\",\n      \"doses_24h\": 2,\n      \"ordem_id\": \"enox-2\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test(\"eventos no contrato: modality prescricoes e paciente pseudonimizado\", () => {",
                  "    pm.expect(corpo.patient_id).to.match(/^pt_[0-9a-f]{24}$/);",
                  "    pm.expect(corpo.eventos.length).to.be.above(0);",
                  "    corpo.eventos.forEach(e => {",
                  "        pm.expect(e.modality).to.eql(\"prescricoes\");",
                  "        pm.expect(e.patient_id).to.eql(corpo.patient_id);",
                  "        pm.expect(e.evidence.thresholds).to.have.property(\"versao_limiares\");",
                  "    });",
                  "});",
                  "const ev = corpo.eventos.find(e => e.event_type === \"mudanca_abrupta_dose\");",
                  "pm.test(\"detecta mudanca_abrupta_dose\", () => pm.expect(ev, \"evento mudanca_abrupta_dose\").to.exist);",
                  "pm.test(\"justificativa com antes × depois\", () => {",
                  "    pm.expect(ev.evidence.summary).to.include(\"subiu 400%\");",
                  "    pm.expect(ev.evidence.features.antes_dose_diaria).to.eql(40);",
                  "    pm.expect(ev.evidence.features.depois_dose_diaria).to.eql(200);",
                  "});",
                  "pm.test(\"anticoagulante (ISMP) sobe a severidade para media\", () => pm.expect(ev.severity).to.eql(\"media\"));"
                ]
              }
            }
          ]
        },
