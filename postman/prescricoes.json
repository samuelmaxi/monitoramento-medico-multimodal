      "item": [
        {
          "id": "ab85b334-f25f-5bc7-b78d-d74ae41ea78d",
          "name": "Paciente real: enoxaparina 40 → 200 mg/dia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/prescricoes/mimic/{{subjectEnoxaparina}}?publicar={{publicar}}",
